name: Changelog

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write      # necessário pro bot commitar o CHANGELOG.md

jobs:
  changelog:
    name: Atualizar CHANGELOG.md
    runs-on: ubuntu-latest
    steps:
      - name: Baixar o repositório (histórico completo)
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Gerar CHANGELOG.md
        run: |
          {
            echo "# Changelog"
            echo ""
            echo "## Histórico de alterações"
            echo ""
            git log \
              --invert-grep --grep='docs: update changelog' \
              --pretty=format:'- %ad — %s (%h)' \
              --date=short
            echo ""
          } > CHANGELOG.md

          echo "===== CHANGELOG ====="
          cat CHANGELOG.md
          cat CHANGELOG.md >> "$GITHUB_STEP_SUMMARY"

      - name: Commitar o CHANGELOG.md de volta no repositório
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add CHANGELOG.md
          if git diff --cached --quiet; then
            echo "Nada mudou no changelog, sem commit."
          else
            git commit -m "docs: update changelog [skip ci]"
            git push
          fi
